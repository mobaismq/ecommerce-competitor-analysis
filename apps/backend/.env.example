# ===== 服务入口 =====

# API 监听端口和地址 必填
PORT=8787
HOST=127.0.0.1

# 管理后台域名，进 CORS 白名单
ADMIN_ORIGIN=https://admin.example.com

# development/production，控制日志级别 必填
NODE_ENV=development

# ===== 数据与中间件 =====
DATABASE_URL=mysql://root:root@127.0.0.1:3308/ecommerce_competitor
REDIS_URL=redis://127.0.0.1:6380

# ===== 认证 =====

# 登录 Token 签名密钥和有效期，必填。线上换至少 32 位随机值
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d

# ===== 初始管理员（仅 seed 建号用，上线前改密码）=====

# admin = 业务租户管理员；super_admin = 超级管理员（开发方，独立 system 租户）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin654321
SUPER_ADMIN_USERNAME=super_admin
SUPER_ADMIN_PASSWORD=admin654321

# ===== AI（统一使用 OpenRouter）=====
AI_KEY_MODE=platform
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY_HERE
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_VISION_MODEL=deepseek/deepseek-v4-flash-vision-exp
OPENROUTER_IMAGE_MODEL=openai/gpt-image-2
AI_MOCK_MODEL=mock-model
DATA_AGENT_RATE_LIMIT_PER_MINUTE=10

# ===== 淘宝开放平台（上架/类目/店铺；未接入前可不填）=====
PLATFORM_MOCK=true
TAOBAO_APP_KEY=
TAOBAO_APP_SECRET=
TAOBAO_SESSION=
TAOBAO_GATEWAY=

# ===== 图片生成与本地导出（开发）=====
# IMAGE_GEN_SIZE：AI 生图输出尺寸（宽x高），按所选生图模型支持范围配置
# MOCK_ASSET_DIR：开发环境生成图片/上传文件的本地落盘目录，留空用 apps/backend/data/mock-assets
# REPORT_EXPORT_DIR：报告导出文件本地落盘目录，留空用 apps/backend/data/report-exports
IMAGE_GEN_SIZE=1024x1024
MOCK_ASSET_DIR=
REPORT_EXPORT_DIR=

# ===== 存储 =====
# local 本地目录 / oss 线上 OSS
STORAGE_DRIVER=local

# 本地存储根目录和对象 key 前缀 默认即可
STORAGE_LOCAL_DIR=
STORAGE_PREFIX={env}/{tenantId}/{bizType}/{runId}

# STORAGE_UPLOAD_SECRET：给“上传票据”做签名的本地密钥，线上必须换成随机值，防止伪造上传
STORAGE_UPLOAD_SECRET=dev-upload-secret

# 本地直传端点
STORAGE_DEV_UPLOAD_URL=http://127.0.0.1:8787/api/storage/dev-upload

# 是否额外同步 OSS
SYNC_ASSET=false

# ===== 旧资产迁移 =====
# LEGACY_ASSET_DIRS：旧项目本地资产生成物目录（如 app/public/generated/product-sets），迁移进新资产体系时填
# LEGACY_ASSET_EXTENSIONS：迁移时允许处理的文件扩展名
LEGACY_ASSET_DIRS=
LEGACY_ASSET_EXTENSIONS=.png,.jpg,.jpeg,.webp,.gif,.mp4,.mov,.webm,.svg

# ===== 视频复刻 =====
VIDEO_PROVIDER=mock

# ===== OSS（线上接入前留空，本地用 LOCAL 目录）=====
OSS_REGION=
OSS_BUCKET=
OSS_ENDPOINT=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PUBLIC_BASE_URL=
