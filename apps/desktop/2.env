# ===== 桌面端环境变量示例（复制为 apps/desktop/.env 后填写，不提交 git）=====
# 本文件只放占位符和注释；真实值按开发/生产对照填写。

# ===== 服务端地址（开发 / 生产对照）=====
# 本地开发：http://127.0.0.1:8787（backend 本地启动）
# 线上生产：https://api.your-domain.com（Nginx 反代后的公网 API 域名）
# 渲染层账号/权限/店铺走这个地址：本地用 127.0.0.1:8787，线上改为远程域名即可。
VITE_API_BASE_URL=http://127.0.0.1:8787

# 采集/报告/资产同步上传的服务端地址；与 VITE_API_BASE_URL 通常一致
SYNC_BASE_URL=http://127.0.0.1:8787

# 三类数据同步开关，默认 false = 本地优先，不主动上传
SYNC_COLLECTION=false
SYNC_REPORT=false
SYNC_ASSET=false

# ===== 渲染进程开发地址（electron-vite dev 自动注入，一般不需要改）=====
# 本地开发：http://127.0.0.1:5173；打包后留空（加载内置 renderer）
ELECTRON_RENDERER_URL=http://127.0.0.1:5173

# ===== 本地数据与运行时目录（开发 / 生产对照）=====
# 本地开发：apps/desktop/data/desktop.db；打包后留空（自动使用系统 userData 目录）
DESKTOP_DB_URL=
# 内置 Python 路径覆盖；打包后留空（自动找 resources/python）
PYTHON_PATH=
# RPA 专用 Chrome 可执行文件路径覆盖；留空则自动探测系统 Chrome
CHROME_PATH=
# Chrome CDP 调试端口；0 = 自动分配空闲端口（推荐）
CHROME_CDP_PORT=0

# ===== 自动更新源（开发 / 生产对照，最终主源待定）=====
# 本地内测包：可留空或指向内部分发地址，不启用自动更新
# 线上正式包：GitHub Releases 或阿里云静态源地址，待最终选型后回填
UPDATE_URL=https://updates.example.invalid/desktop
