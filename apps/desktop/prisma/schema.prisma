generator client {
  provider     = "prisma-client-js"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "sqlite"
  url      = env("DESKTOP_DB_URL")
}

model LocalJob {
  id           String          @id
  jobId        String          @unique
  type         String
  status       String
  pid          Int?
  inputJson    String?
  resultJson   String?
  errorCode    String?
  errorMessage String?
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  events       LocalJobEvent[]
  tempFiles    TempFile[]
}

model LocalJobEvent {
  id        String    @id
  jobId     String
  type      String
  data      String?
  createdAt DateTime  @default(now())
  job       LocalJob  @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model TempFile {
  id        String    @id
  jobId     String?
  kind      String
  path      String    @unique
  size      Int
  status    String
  createdAt DateTime  @default(now())
  job       LocalJob? @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

// ===== 本地能力数据模型（从后端能力模型迁入，SQLite 化）=====
// 说明：Decimal→Float；Json 由 SQLite 以 TEXT 存储；tenantId 保留为普通列，
// 账号维度(多租户/权限)仍留在服务端 MySQL。

model Job {
  id                String    @id @default(cuid())
  tenantId          String
  type              String
  businessKey       String    @unique
  status            String
  stage             String?
  attempt           Int       @default(0)
  checkpointStage   String?
  parentJobId       String?
  userId            String?
  agentId           String?
  providerProfileId String?
  paramsJson        Json?
  errorCode         String?
  errorMessage      String?
  retryCount        Int       @default(0)
  claimDeadline     DateTime?
  nextRetryAt       DateTime?
  startedAt         DateTime?
  finishedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([tenantId, status, type])
  @@index([tenantId, createdAt])
}

model JobEvent {
  id        String   @id @default(cuid())
  jobId     String
  type      String
  data      Json?
  createdAt DateTime @default(now())

  @@index([jobId, createdAt])
}

model CollectionJob {
  id            String   @id @default(cuid())
  tenantId      String
  jobId         String   @unique
  type          String
  status        String
  storeId       String?
  keyword       String?
  rawResultJson Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId, status])
}

model SourceFileRecord {
  id             String  @id @default(cuid())
  tenantId       String
  collectionJobId String?
  storageKey     String  @unique
  mimeType       String
  size           Int
  originalName   String?
  sha256         String?
  sourceUrl      String?
  createdAt      DateTime @default(now())

  @@index([tenantId, collectionJobId])
}

model ProductSnapshot {
  id               String   @id @default(cuid())
  tenantId         String
  collectionJobId  String
  externalProductId String
  title            String?
  price            Float?
  shopId           String?
  shopName         String?
  snapshotTime     DateTime
  dataSnapshotDate String
  rawJson          Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([collectionJobId, externalProductId])
  @@index([tenantId, snapshotTime])
}

model ProductSkuSnapshot {
  id                String  @id @default(cuid())
  productSnapshotId String
  skuId             String
  name              String?
  price             Float?
  imageUrl          String?
  createdAt         DateTime @default(now())

  @@index([productSnapshotId])
}

model ProductQaSnapshot {
  id                String  @id @default(cuid())
  productSnapshotId String
  question          String?
  answer            String?
  createdAt         DateTime @default(now())

  @@index([productSnapshotId])
}

model ProductReviewSnapshot {
  id                String  @id @default(cuid())
  productSnapshotId String
  content           String?
  rating            Int?
  createdAt         DateTime @default(now())

  @@index([productSnapshotId])
}

model AnalysisRun {
  id             String   @id @default(cuid())
  tenantId       String
  jobId          String   @unique
  storeId        String?
  keyword        String?
  analysisType   String
  reportNo       String?
  reportHash     String?
  status         String
  competitorCount Int?
  costModelJson  Json?
  reportJson     Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tenantId, status])
}

model AnalysisPriceBand {
  id                String @id @default(cuid())
  analysisRunId     String
  bandName          String
  priceMin          Float?
  priceMax          Float?
  productCount      Int
  analysisStatus    String  @default("raw")
  sellingPointsJson Json?
  demandsJson       Json?
  imagePromptsJson  Json?
  profitSimulationJson Json?
  createdAt         DateTime @default(now())

  @@index([analysisRunId])
}

model AnalysisBandProduct {
  id                String  @id @default(cuid())
  priceBandId       String
  productSnapshotId String?
  externalProductId String?
  title             String?
  price             Float?
  imageUrl          String?
  createdAt         DateTime @default(now())

  @@index([priceBandId])
}

model AnalysisBandImage {
  id          String  @id @default(cuid())
  priceBandId String
  imageUrl    String?
  storageKey  String?
  createdAt   DateTime @default(now())

  @@index([priceBandId])
}

model AnalysisProductAnalysis {
  id                String @id @default(cuid())
  analysisRunId     String
  productSnapshotId String?
  productTitle      String?
  analysisJson      Json?
  createdAt         DateTime @default(now())

  @@index([analysisRunId])
}

model AnalysisInsight {
  id            String @id @default(cuid())
  analysisRunId String
  type          String
  title         String?
  content       String?
  createdAt     DateTime @default(now())

  @@index([analysisRunId])
}

model MainImageAnalysis {
  id            String @id @default(cuid())
  analysisRunId String
  productId     String?
  imageUrl      String?
  storageKey    String?
  visionModel   String?
  prompt        String?
  resultJson    Json?
  createdAt     DateTime @default(now())

  @@index([analysisRunId])
}

model ListingDraft {
  id            String  @id @default(cuid())
  tenantId      String
  jobId         String  @unique
  analysisRunId String?
  platformId    String?
  title         String?
  contentJson   Json?
  status        String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId, status])
}

model MediaAsset {
  id         String   @id @default(cuid())
  tenantId   String
  sourceType String
  storageKey String   @unique
  mimeType   String
  size       Int
  sha256     String?
  sourceUrl  String?
  originalName String?
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
}

model GeneratedAsset {
  id           String   @id @default(cuid())
  tenantId     String
  jobId        String?
  analysisRunId String?
  storageKey   String   @unique
  mimeType     String
  size         Int
  sha256       String?
  originalName String?
  sourceUrl    String?
  runId        String?
  category     String?
  prompt       String?
  ratio        String?
  productId    String?
  productName  String?
  createdBy    String?
  platform     String?
  createdAt    DateTime @default(now())

  @@index([tenantId, createdAt])
}

model Agent {
  id               String   @id @default(cuid())
  tenantId         String
  name             String?
  platform         String?
  version          String?
  capabilitiesJson Json?
  deviceSecretHash String?
  status           String
  lastSeenAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([tenantId, status])
}

model AgentAssignment {
  id         String    @id @default(cuid())
  agentId    String
  jobId      String
  status     String
  leaseUntil DateTime?
  heartbeatAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([agentId, jobId])
  @@unique([jobId])
  @@index([jobId])
}

model ReviewRecord {
  id         String   @id @default(cuid())
  tenantId   String
  jobId      String
  assetId    String?
  reviewType String
  decision   String
  comment    String?
  reviewerId String?
  reviewedAt DateTime?
  createdAt  DateTime @default(now())

  @@index([tenantId, decision])
}

model AiUsageLog {
  id                String   @id @default(cuid())
  tenantId          String
  jobId             String?
  attemptKey        String   @unique
  providerProfileId String?
  providerType      String
  model             String?
  status            String
  tokenIn           Int?
  tokenOut          Int?
  durationMs        Int?
  error             String?
  createdAt         DateTime @default(now())

  @@index([tenantId, createdAt])
}

model AiCallCache {
  id           String   @id @default(cuid())
  tenantId     String
  requestHash  String   @unique
  providerType String
  model        String?
  resultJson   Json?
  status       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId])
}

model ProviderProfile {
  id               String   @id @default(cuid())
  tenantId         String?
  storeId          String?
  name             String
  type             String
  baseUrl          String?
  apiKeyRef        String
  capabilitiesJson Json?
  modelConfigJson  Json?
  timeoutMs        Int?
  retryPolicyJson  Json?
  limitsJson       Json?
  enabled          Boolean  @default(true)
  priority         Int      @default(0)
  healthStatus     String?
  lastError        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([tenantId, enabled])
}

model Product {
  id           String   @id @default(cuid())
  tenantId     String
  productCode  String
  productName  String
  brand        String?
  productImage String?
  storeId      String?
  status       String   @default("enabled")
  skus         ProductSku[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, productCode])
  @@index([tenantId, status])
  @@index([tenantId, storeId])
}

model ProductSku {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  skuCode      String
  specName     String?
  specImage    String?
  costPrice    Float?
  standardPrice Float?
  createdAt     DateTime @default(now())

  @@index([productId])
}
