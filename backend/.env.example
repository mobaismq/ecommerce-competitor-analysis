PORT=8787
HOST=127.0.0.1
FRONTEND_ORIGIN=http://127.0.0.1:5173
NODE_ENV=production

ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
SESSION_SECRET=CHANGE_ME_TO_AT_LEAST_32_RANDOM_CHARACTERS
SESSION_TTL_SECONDS=28800
REPORT_PRODUCT_ANALYSIS_CONCURRENCY=2
AUTO_MAIN_IMAGE_AI_REPORT=false

# 旧项目运行仍复用 app/.env.local 中的 MySQL/淘宝配置；新架构逐项收敛到本文件。

# AI 供应商（旧项目同事提供参考值，2026-09-12 录入；KEY 为占位符，上线前替换）
# 新架构 Phase 4 将迁移为 ProviderProfile 配置，见 design.md「AI 供应商适配设计」。
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY_HERE
OPENROUTER_IMAGE_MODEL=openai/gpt-image-2
OPENROUTER_VISION_MODEL=deepseek/deepseek-v4-flash-vision-exp
OPENROUTER_VISION_FALLBACK_MODEL=openai/gpt-4.1-mini
ARK_ANALYSIS_MODEL=doubao-seed-2-1-pro-260628
ARK_ANALYSIS_MAX_IMAGES=20
ARK_ANALYSIS_BATCH_IMAGES=5
ARK_ANALYSIS_TIMEOUT_MS=120000
ARK_PRODUCT_ANALYSIS_MAX_OUTPUT_TOKENS=8000
ARK_PRICE_BAND_MAX_OUTPUT_TOKENS=3000
ARK_OVERALL_REPORT_MAX_OUTPUT_TOKENS=10000
ARK_DATA_AGENT_MAX_OUTPUT_TOKENS=3000
# 同事原文件未提供；旧代码实际读取 ARK_API_KEY（缺省回退 OPENAI_API_KEY）
# ARK_API_KEY=YOUR_ARK_API_KEY_HERE
